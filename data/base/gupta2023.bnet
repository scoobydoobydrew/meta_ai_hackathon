# Gupta et al. 2023, Cells 12(7):1085, doi 10.3390/cells12071085 (article CC BY 4.0).
# Rules read from the Rule rows of Supplementary Table S2 by cellproof.network.gupta2023;
# the mTORC2 rule lacked its last closing parenthesis in Table S2 and is balanced as in Table S1.
# DNA_damage is the model's only input (constant). Node ids differ from the paper's spelling for:
# ATM_pH2AX (ATM/pH2AX), AMPK_MAPK (AMPK/MAPK), p53_A, p53_K, p53_INP1, Cdc2_CycB, miR221 (miR-221),
# ULK1_Beclin1 (ULK1/Beclin1; the S2 regulator list says ULK1), mTORC1/mTORC2 (S2 also says mTOR1/mTOR2).
targets, factors
DNA_damage, DNA_damage
ATM_pH2AX, DNA_damage & (!Wip1 | !Cdc25 | E2F1)
AMPK_MAPK, ATM_pH2AX & !Wip1
Mdm2, (!Wip1 | p53) & !ATM_pH2AX & !miR221 & !PTEN & AKT
p53, ATM_pH2AX | (!Mdm2 & AMPK_MAPK & !hTERT)
p53_A, !Sirt1 & !p53_K & (p53 | !p53_INP1)
p53_INP1, p53_K | p53_A
p53_K, !p53_A & (!Sirt1 | !Wip1) & p53
p21, p53_A | (!Myc & !AKT & !Caspase & AMPK_MAPK)
Wip1, p53_A
RB, !(Cdc2_CycB & Cdc25)
Myc, (E2F1 | AMPK_MAPK | AKT) & !RB & !p21
WWP1, Myc
hTERT, (AKT | Myc) & !p53 & !PTEN
E2F1, (!RB & ((Cdc25 & ATM_pH2AX) | !Sirt1 | !PTEN)) | Myc
Cdc25, (!ATM_pH2AX | !AMPK_MAPK) & !Wee1 & !PTEN
Sirt1, E2F1
Cdc2_CycB, Cdc25 & !Wee1 & !PTEN & !p21
Wee1, !AKT
TUG1, p53
miR221, !TUG1 | E2F1
PTEN, !miR221 & (ATM_pH2AX | p53_K) & !WWP1
AKT, !PTEN | mTORC2
mTORC1, AKT & !(ULK1_Beclin1 & AMPK_MAPK)
mTORC2, AKT | (!PTEN & (!mTORC1 | !Sirt1 | !hTERT | !AMPK_MAPK))
ULK1_Beclin1, !mTORC2 & !mTORC1 & AMPK_MAPK
BCL2, !PUMA & E2F1 & !p53_K
PUMA, p53_K & !miR221
BAX, !BCL2 & p53_K
Caspase, !(BCL2 & p21) & BAX
